# microservice specific routes

GET        /traders/get-known-facts/:vrn        uk.gov.hmrc.euvatstubs.controllers.EuVatDataCacheController.getTraderByVrn(vrn: String)
POST       /create-application/:vrn             uk.gov.hmrc.euvatstubs.controllers.EuVatCandeDataController.addApplication(vrn: String)
POST       /get-latest-application              uk.gov.hmrc.euvatstubs.controllers.EuVatCandeDataController.getLatestApplications
POST       /add-purchase                        uk.gov.hmrc.euvatstubs.controllers.EuVatCandeDataController.addPurchase
POST       /get-supplier-taxIdentifier-count   uk.gov.hmrc.euvatstubs.controllers.EuVatCandeDataController.getSupplierTaxIdentifierCount()
